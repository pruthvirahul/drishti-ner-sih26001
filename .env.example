# ==========================================
# DRISHTI-NER ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual production API keys
# ==========================================

# 1. SERVER CONFIGURATION
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com

# 2. METEOROLOGICAL & WEATHER APIS
# India Meteorological Department (IMD) / OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key_here
IMD_AWS_API_TOKEN=your_imd_token_here

# 3. SATELLITE & SOIL MOISTURE APIS
# Copernicus Open Access Hub / ISRO Bhuvan WMS
COPERNICUS_SENTINEL_CLIENT_ID=your_sentinel_client_id
COPERNICUS_SENTINEL_CLIENT_SECRET=your_sentinel_secret
ISRO_BHUVAN_API_KEY=your_isro_bhuvan_api_key

# 4. TELECOM & CELL BROADCAST (C-DOT / NDMA GATEWAY)
# Department of Telecom / C-DOT Common Alerting Protocol (CAP) Endpoint
CDOT_CAP_SERVER_URL=https://cap.ndma.gov.in/api/v1/broadcast
CDOT_AGENCY_AUTH_TOKEN=your_cdot_agency_token_here

# 5. WHATSAPP BUSINESS CLOUD API & SMS GATEWAY
# Meta for Developers - WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_token
WHATSAPP_VERIFY_TOKEN=drishti_ner_webhook_secret_2026

# Twilio SMS / Fast2SMS (Indian SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 6. EMERGENCY MEDICAL & NDRF DISPATCH WEBHOOKS
EMERGENCY_MEDICAL_SDMA_WEBHOOK=https://sdma.meghalaya.gov.in/api/emergency-dispatch
NDRF_QUICK_RESPONSE_WEBHOOK=https://ndrf.gov.in/api/battalion-alert
